# Copy this file to .env and set real values as needed

# Enable debug logging (true/false)
DEBUG_LOGS_ENABLED=false

# Cloudflare bypass via captcha solving (optional)
# When set, Turnstile challenges are solved automatically.
# When empty, CF-protected pages return an error.
# CAPTCHA_API_KEY=your_api_key_here
# CAPTCHA_PROVIDER=2captcha
# CAPTCHA_BASE_URL=
# CAPTCHA_TIMEOUT=120
